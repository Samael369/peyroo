# ==============================================================================
# Peyroo Environment Configuration Template
# Copy this file to .env and configure local values.
# NEVER commit the real .env file with production secrets to version control.
# ==============================================================================

# Node Environment ('development', 'test', 'production')
NODE_ENV=development

# Backend API Configuration (apps/api)
PORT=5000
CORS_ORIGIN=http://localhost:3000

# Database Connection (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peyroo?schema=public"

# Frontend Configuration (apps/web)
VITE_API_URL=http://localhost:5000
