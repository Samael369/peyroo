// ==============================================================================
// Prisma Configuration Schema - Peyroo (پیرو)
//
// NOTE: This file establishes database configuration and client generation only.
// Domain business models (Users, Mentors, Bookings, Schedules) will be introduced
// in future feature phases following finalization of data domain requirements.
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
