{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Peyroo Oceanic Precision Design Tokens",
  "version": "1.0.0",
  "description": "Formal W3C DTCG-compliant design tokens for the Peyroo Mentorship Platform UI, matching Stage 07 Oceanic Precision specifications.",
  "color": {
    "brand": {
      "primary1": {
        "canvas": { "value": "#0A1128", "type": "color", "description": "Deep canvas base background" },
        "surface": { "value": "#0F172A", "type": "color", "description": "Card and sidebar surface" },
        "raised": { "value": "#1E293B", "type": "color", "description": "Elevated cards, modals, and dropdowns" },
        "border": { "value": "#334155", "type": "color", "description": "Dividers, inputs, and structural outlines" }
      },
      "primary2": {
        "action": { "value": "#0284C7", "type": "color", "description": "Primary interactive buttons, links, and active tabs" },
        "hover": { "value": "#0369A1", "type": "color", "description": "Hover state for primary action surfaces" },
        "subtle": { "value": "#0C4A6E", "type": "color", "description": "Active slot container background, subtle chip fills" },
        "focusRing": { "value": "#38BDF8", "type": "color", "description": "Focus ring outline for accessibility compliance" }
      },
      "punch": {
        "emerald": { "value": "#10B981", "type": "color", "description": "High-stakes conversion CTAs, hero mesh gradient, and confirmed indicators" },
        "hover": { "value": "#059669", "type": "color", "description": "Hover state for high-stakes emerald triggers" },
        "glow": { "value": "rgba(16, 185, 129, 0.25)", "type": "color", "description": "Ambient pulse halo and mesh gradient glow" }
      }
    },
    "neutral": {
      "text": {
        "primary": { "value": "#F8FAFC", "type": "color", "description": "Headings, titles, and mentor display names" },
        "secondary": { "value": "#94A3B8", "type": "color", "description": "Descriptions, bios, and metadata" },
        "muted": { "value": "#64748B", "type": "color", "description": "Timestamps, hints, and placeholder labels" },
        "disabled": { "value": "#475569", "type": "color", "description": "Inactive slots and disabled button text" }
      }
    },
    "semantic": {
      "success": { "value": "#10B981", "type": "color", "description": "Payment confirmed, session completed, slot published" },
      "warning": { "value": "#F59E0B", "type": "color", "description": "15-minute booking hold timer, slot expiring soon" },
      "error": { "value": "#EF4444", "type": "color", "description": "Payment failed, session cancelled, validation error" },
      "info": { "value": "#38BDF8", "type": "color", "description": "Booking reminder, system advisory notification" }
    },
    "slots": {
      "available": {
        "bg": { "value": "#0F172A", "type": "color" },
        "border": { "value": "#334155", "type": "color" },
        "text": { "value": "#F8FAFC", "type": "color" }
      },
      "selected": {
        "bg": { "value": "#0C4A6E", "type": "color" },
        "border": { "value": "#0284C7", "type": "color" },
        "text": { "value": "#38BDF8", "type": "color" }
      },
      "held": {
        "bg": { "value": "#78350F25", "type": "color" },
        "border": { "value": "#F59E0B", "type": "color" },
        "text": { "value": "#FBBF24", "type": "color" }
      },
      "booked": {
        "bg": { "value": "#1E293B40", "type": "color" },
        "border": { "value": "#1E293B", "type": "color" },
        "text": { "value": "#475569", "type": "color" }
      },
      "confirmed": {
        "bg": { "value": "#064E3B30", "type": "color" },
        "border": { "value": "#10B981", "type": "color" },
        "text": { "value": "#34D399", "type": "color" }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": { "value": "Plus Jakarta Sans, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif", "type": "fontFamily" },
      "mono": { "value": "JetBrains Mono, ui-monospace, SFMono-Regular, monospace", "type": "fontFamily" }
    },
    "fontSize": {
      "display2xl": { "value": "48px", "type": "dimension", "description": "Hero landing headline" },
      "displayXl": { "value": "36px", "type": "dimension", "description": "Section titles, dashboard headers" },
      "headingLg": { "value": "24px", "type": "dimension", "description": "Mentor profile name, modal title" },
      "headingMd": { "value": "20px", "type": "dimension", "description": "Card titles, calendar month header" },
      "bodyBase": { "value": "16px", "type": "dimension", "description": "Bio body text, session descriptions" },
      "bodySm": { "value": "14px", "type": "dimension", "description": "Table rows, input labels, card details" },
      "captionXs": { "value": "12px", "type": "dimension", "description": "Badges, slot status, rating counts" },
      "monoBase": { "value": "14px", "type": "dimension", "description": "Slot times, monetary pricing" }
    },
    "lineHeight": {
      "display2xl": { "value": "56px", "type": "dimension" },
      "displayXl": { "value": "44px", "type": "dimension" },
      "headingLg": { "value": "32px", "type": "dimension" },
      "headingMd": { "value": "28px", "type": "dimension" },
      "bodyBase": { "value": "24px", "type": "dimension" },
      "bodySm": { "value": "20px", "type": "dimension" },
      "captionXs": { "value": "16px", "type": "dimension" },
      "monoBase": { "value": "20px", "type": "dimension" }
    },
    "fontWeight": {
      "extraBold": { "value": "800", "type": "fontWeight" },
      "bold": { "value": "700", "type": "fontWeight" },
      "semiBold": { "value": "600", "type": "fontWeight" },
      "medium": { "value": "500", "type": "fontWeight" },
      "regular": { "value": "400", "type": "fontWeight" }
    }
  },
  "border": {
    "radius": {
      "sm": { "value": "4px", "type": "dimension" },
      "md": { "value": "8px", "type": "dimension" },
      "lg": { "value": "12px", "type": "dimension" },
      "xl": { "value": "16px", "type": "dimension" },
      "full": { "value": "9999px", "type": "dimension" }
    }
  },
  "spacing": {
    "xs": { "value": "4px", "type": "dimension" },
    "sm": { "value": "8px", "type": "dimension" },
    "md": { "value": "16px", "type": "dimension" },
    "lg": { "value": "24px", "type": "dimension" },
    "xl": { "value": "32px", "type": "dimension" },
    "2xl": { "value": "48px", "type": "dimension" },
    "3xl": { "value": "64px", "type": "dimension" }
  }
}
