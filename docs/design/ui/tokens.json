        "textOnPunch": { "value": "#3B2418", "type": "color", "description": "Dark espresso text on baby blue for 8.5:1 WCAG AAA contrast" }
      }
    },
    "neutral": {
      "text": {
        "primary": { "value": "#3B2418", "type": "color", "description": "Headings, titles, and mentor display names" },
        "secondary": { "value": "#6B4D3B", "type": "color", "description": "Descriptions, bios, and secondary metadata" },
        "muted": { "value": "#8C7160", "type": "color", "description": "Timestamps, hints, and placeholder labels" },
        "disabled": { "value": "#B8A89A", "type": "color", "description": "Inactive slots and disabled button text" }
      }
    },
    "semantic": {
      "success": { "value": "#2E7D32", "type": "color", "description": "Session confirmed, completed" },
