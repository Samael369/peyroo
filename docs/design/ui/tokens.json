{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Peyroo Warm Vintage Minimalist Design Tokens (Cream & Baby Blue)",
  "version": "2.0.0",
  "description": "Formal W3C DTCG-compliant design tokens for Peyroo Mentorship Platform UI, featuring the approved Cream & Baby Blue Warm Light aesthetic (60% Cream, 30% Espresso Brown, 10% Sky Baby Blue).",
  "color": {
    "brand": {
      "primary1": {
        "canvas": { "value": "#F2E8DA", "type": "color", "description": "60% Primary Canvas: Warm Vintage Cream linen background" },
        "surface": { "value": "#FFFFFF", "type": "color", "description": "Pure white card and modal surface" },
        "surfaceWarm": { "value": "#FAF6F0", "type": "color", "description": "Elevated warm card surface" },
        "border": { "value": "#E2D5C3", "type": "color", "description": "Delicate warm sand divider and card border" },
        "badgeBg": { "value": "#E8DDD0", "type": "color", "description": "Subtle badge and tag container fill" }
      },
      "primary2": {
        "structure": { "value": "#3B2418", "type": "color", "description": "30% Secondary Structure: Deep Roasted Espresso Brown for headings, brand mark, and nav text" },
        "subtle": { "value": "#523726", "type": "color", "description": "Secondary coffee tone for subtext and metadata" },
        "borderSubtle": { "value": "#D5C4AF", "type": "color", "description": "Stronger structural borders and outlines" }
      },
      "punch": {
        "babyBlue": { "value": "#8EC5FF", "type": "color", "description": "10% Loud Accent: Sky Baby Blue for high-stakes conversion CTAs, active highlights, and verification" },
